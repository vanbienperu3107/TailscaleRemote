# Deploy proxy-node trên bất kỳ VPS nào:
#   cp .env.example .env
#   vim .env        # điền TS_AUTHKEY và TS_LOGIN_SERVER
#   docker compose up -d
#
# Sau khi node join tailnet, thành viên set proxy:
#   SOCKS5: socks5://<tailscale-ip-của-node>:1080
#   HTTP:   http://<tailscale-ip-của-node>:8118
# (xem IP bằng: docker exec proxy-node tailscale ip -4)

# ── Tailscale join ─────────────────────────────────────────────────────────────
# Auth key tạo trên Admin-UI → Pre-auth Keys → Create
TS_AUTHKEY=tskey-auth-xxx

# Tên node trong tailnet (hiển thị trên Admin-UI)
EXIT_NODE_HOSTNAME=proxy-vn

# URL headscale control server (PHẢI set nếu dùng headscale self-hosted)
TS_LOGIN_SERVER=https://vpn2.hangocthanh.io.vn

# ── Proxy auth (tùy chọn nhưng khuyến nghị) ───────────────────────────────────
# Nếu để trống: proxy mở, ai trong tailnet cũng dùng được
# Nếu set: thành viên phải điền user/pass khi set proxy
PROXY_USER=
PROXY_PASS=

# ── Proxy port binding ─────────────────────────────────────────────────────────
# Port SOCKS5 (publish ra host — thành viên connect tới port này)
SOCKS5_PORT=1080
# Port HTTP proxy
HTTP_PORT=8118
# Bind address — mặc định 0.0.0.0 (nghe mọi interface)
# Đổi thành tailscale IP để chỉ cho phép trong tailnet:
#   SOCKS5_BIND=100.x.x.x
SOCKS5_BIND=0.0.0.0
HTTP_BIND=0.0.0.0

# ── Tùy chọn: cũng quảng bá làm Tailscale exit-node ─────────────────────────
# Nếu true: node vừa là proxy, vừa là exit-node Tailscale (2-in-1)
# Phải được auto-approve bởi latency module (AUTO_APPROVE_ROUTES=true)
ADVERTISE_EXIT_NODE=false
