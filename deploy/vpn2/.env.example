# Tham khảo các biến môi trường cần thiết cho stack vpn2.
# KHÔNG commit file .env thật — chỉ commit file .env.example này.
# Workflow deploy-vpn2.yml sẽ tự ghi .env từ GitHub Secrets.

# ── Domain ────────────────────────────────────────────────────────────────────
# Domain chính của server này — dùng cho Caddyfile TLS, DERP relay hostname,
# và collector-sidecar login-server URL.
# CẢNH BÁO: server_url trong config/config.yaml là cam kết vĩnh viễn với
# DERP-Controller. Đổi domain → toàn bộ client phải re-register vào tailnet.
DOMAIN=vpn2.hangocthanh.io.vn

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# ── Session ───────────────────────────────────────────────────────────────────
# openssl rand -hex 32
SESSION_SECRET=change_me_32chars_minimum_random

# ── Access control ────────────────────────────────────────────────────────────
ALLOWED_EMAILS=admin@example.com,other@example.com

# ── Api-center ────────────────────────────────────────────────────────────────
# URL công khai mà người dùng truy cập Admin-UI (dùng cho OAuth redirect).
PUBLIC_URL=https://vpn2.hangocthanh.io.vn/app

# URL để api-center gọi DERP-Controller:
# - Cùng host (mặc định): http://derp-controller:8080 (Docker internal DNS)
# - Khác host: https://<domain-của-derp-controller>
HEADSCALE_API_URL=http://derp-controller:8080

# ── DERP-Controller ───────────────────────────────────────────────────────────
# Tạo bằng: docker compose exec derp-controller headscale apikeys create
HEADSCALE_API_KEY=hsapi_xxx
# openssl rand -hex 32
HEADSCALE_DASHBOARD_SECRET=change_me_32chars_minimum_random

# ── Latency module ────────────────────────────────────────────────────────────
# URL để latency gọi DERP-Controller API (tương tự HEADSCALE_API_URL):
# - Cùng host: http://derp-controller:8080
# - Khác host: https://<domain-của-derp-controller>
HS_API_URL=http://derp-controller:8080
DEDUP_DRY_RUN=false
AUTO_APPROVE_ROUTES=true

# DERP relay endpoints để probe (latency dashboard hiển thị trạng thái relay).
# Format: "regionCode=https://hostname/derp/probe,..."
# Cập nhật khi thêm/bỏ relay node. Để trống = dùng default trong Python code.
DERP_PROBE_URLS=myderp=https://vpn2.hangocthanh.io.vn/derp/probe,vpn3-vn=https://vpn3.hangocthanh.io.vn/derp/probe,vpn4-vn=https://vpn4.hangocthanh.io.vn/derp/probe,vpn6-vn=https://vpn6.hangocthanh.io.vn/derp/probe

# ── Collector Sidecar ─────────────────────────────────────────────────────────
# Pre-auth key tạo qua Admin-UI → Pre-auth Keys.
TS_AUTHKEY=tskey-auth-xxx

# Tham số kết nối tailnet cho collector.
# Cập nhật --login-server nếu domain của DERP-Controller thay đổi.
# COUPLING: latency + collector-sidecar PHẢI chạy cùng host (chia sẻ Unix socket).
TS_EXTRA_ARGS=--login-server=https://vpn2.hangocthanh.io.vn --hostname=collector --accept-dns=false
