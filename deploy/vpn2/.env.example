# Tham khảo biến môi trường cho stack vpn2 (primary) + vpn6 (HA replica).
# KHÔNG commit file .env thật. Workflow deploy-control-plane.yml tự ghi .env từ secrets.
#
# ── HA NOTE ──────────────────────────────────────────────────────────────────
# Các biến DATABASE_URL, HS_DB_*, SESSION_SECRET, HEADSCALE_NOISE_KEY,
# GOOGLE_*, HEADSCALE_* PHẢI GIỐNG NHAU trên vpn2 và vpn6.
# Cloudflare LB trỏ CONTROL_DOMAIN → vpn2 + vpn6 (health check /healthz).

# ── Domain ────────────────────────────────────────────────────────────────────
# Domain HA (LB giữa vpn2 và vpn6 qua Cloudflare).
# Đây là giá trị của server_url trong headscale config.
# CẢNH BÁO: Thay đổi domain = toàn bộ client phải re-register tailnet.
CONTROL_DOMAIN=vpn2.hangocthanh.io.vn
DOMAIN=vpn2.hangocthanh.io.vn

# ── Database (Neon Postgres — chia sẻ giữa vpn2 và vpn6) ─────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Headscale đọc DB config qua viper env vars (HEADSCALE_DATABASE_POSTGRES_*).
# Lấy từ DATABASE_URL hoặc điền riêng từng trường:
HS_DB_HOST=ep-xxx.us-east-2.aws.neon.tech
HS_DB_NAME=neondb
HS_DB_USER=neondb_owner
HS_DB_PASS=your_neon_password

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# ── Session ───────────────────────────────────────────────────────────────────
# PHẢI giống nhau trên vpn2 và vpn6 — dùng để verify session cookie.
# openssl rand -hex 32
SESSION_SECRET=change_me_32chars_minimum_random

# ── Access control ────────────────────────────────────────────────────────────
ALLOWED_EMAILS=admin@example.com,other@example.com

# ── Api-center ────────────────────────────────────────────────────────────────
# PUBLIC_URL = URL công khai qua Cloudflare LB (dùng CONTROL_DOMAIN).
PUBLIC_URL=https://vpn2.hangocthanh.io.vn/app
HEADSCALE_API_URL=http://derp-controller:8080
HS_API_URL=http://derp-controller:8080

# ── DERP-Controller ───────────────────────────────────────────────────────────
# Tạo: docker compose exec derp-controller headscale apikeys create
HEADSCALE_API_KEY=hsapi_xxx
# openssl rand -hex 32
HEADSCALE_DASHBOARD_SECRET=change_me_32chars_minimum_random

# ── Headscale noise_private.key (HA critical) ─────────────────────────────────
# PHẢI giống nhau trên vpn2 và vpn6. Tạo 1 lần, lưu vĩnh viễn.
# Lấy sau lần deploy đầu tiên:
#   docker exec derp-controller cat /etc/headscale-keys/noise_private.key | base64
# Lưu kết quả làm GitHub Secret HEADSCALE_NOISE_KEY.
# Deploy workflow ghi file ./headscale-keys/noise_private.key từ secret này.
HEADSCALE_NOISE_KEY=base64_encoded_content_of_noise_private_key

# ── Latency module ────────────────────────────────────────────────────────────
DEDUP_DRY_RUN=false
AUTO_APPROVE_ROUTES=true
DERP_PROBE_URLS=myderp=https://vpn2.hangocthanh.io.vn/derp/probe,vpn3-vn=https://vpn3.hangocthanh.io.vn/derp/probe,vpn4-vn=https://vpn4.hangocthanh.io.vn/derp/probe,vpn6-vn=https://vpn6.hangocthanh.io.vn/derp/probe

# ── Collector Sidecar (chỉ chạy trên vpn2) ────────────────────────────────────
TS_AUTHKEY=tskey-auth-xxx
# Cập nhật login-server nếu CONTROL_DOMAIN thay đổi
TS_EXTRA_ARGS=--login-server=https://vpn2.hangocthanh.io.vn --hostname=collector --accept-dns=false
